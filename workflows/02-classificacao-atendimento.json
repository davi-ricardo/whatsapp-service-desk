    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst message = String($json.message || '').toLowerCase().trim();\n\nconst technicalPatterns = [\n  /não liga|nao liga/,\n  /não inicia|nao inicia/,\n  /não conecta|nao conecta/,\n  /sem internet/,\n  /internet caiu/,\n  /não imprime|nao imprime/,\n  /impressora.*erro/,\n  /computador.*travando/,\n  /computador.*lento/,\n  /tela azul/,\n  /erro ao abrir/,\n  /sistema.*não funciona|sistema.*nao funciona/\n];\n\nconst informationalPatterns = [\n  /onde (posso|devo|consigo)/,\n  /como (faço|fazer|solicito|solicitar)/,\n  /qual (é|e) o procedimento/,\n  /como abrir (um )?cadastro/,\n  /onde solicitar/\n];\n\nlet intent = 'unclear';\nlet intent_reason = 'Mensagem não classificada com segurança';\n\nif (technicalPatterns.some(pattern => pattern.test(message))) {\n  intent = 'technical_support';\n  intent_reason = 'Possível problema técnico identificado';\n} else if (informationalPatterns.some(pattern => pattern.test(message))) {\n  intent = 'informational';\n  intent_reason = 'Dúvida sobre procedimento ou informação';\n}\n\nreturn {\n  json: {\n    ...$json,\n    intent,\n    intent_reason\n  }\n};\n"
      },
